# Copy to /etc/snipnote-transcription/env on the VPS, chmod 600, root-owned.
# systemd EnvironmentFile: KEY=value, one per line, no `export`, no quoting.

# --- Secrets ---
OPENAI_API_KEY=sk-proj-...
SUPABASE_URL=https://bndbnqtvicvynzkyygte.supabase.co
SUPABASE_SERVICE_KEY=eyJ...

# Leave unset to match the current Render behaviour. Setting it makes the API
# require an X-API-Key header, which neither the iOS nor the web client sends
# today — only set it as part of a coordinated client release.
# API_KEY=

# --- Tuning ---
# gpt-transcribe: $0.0045/min. Set to gpt-4o-transcribe to roll back.
TRANSCRIPTION_MODEL=gpt-transcribe

# This box has 2 vCPU / 3.7GB shared with other services. Both values are lower
# than the Render defaults (3 and 5) to keep peak RAM inside the worker's
# MemoryMax=1500M. See MEMORY_OPTIMIZATION_PLAN.md.
MAX_CONCURRENT_JOBS=1
MAX_CHUNK_WORKERS=2

# Poll interval for the continuous worker. Replaces Render's cron trigger.
WORKER_INTERVAL_SECONDS=20

# --- xAI single-request transcription (provider "xai" only; OpenAI is unchanged) ---
# xAI jobs upload the whole meeting in ONE request (joined + re-encoded to mono
# 16 kHz MP3 with ffmpeg) instead of the 15MB / 1.5MB chunk pipeline. Any failure
# other than 401/403 falls back to the old chunked path. Set to false to force the
# old path for all xAI jobs (no restart of anything else needed, just the worker).
XAI_SINGLE_REQUEST_ENABLED=true
# Largest prepared file (bytes) sent in one request; bigger -> chunked path.
# xAI's documented cap is reportedly 500MB (UNVERIFIED); 100MB is conservative
# (a 2h meeting at 48 kbps is ~40MB).
XAI_SINGLE_REQUEST_MAX_BYTES=104857600
# Read/write timeout of the single request, seconds. Attempts on transient errors.
XAI_STT_TIMEOUT_SECONDS=900
XAI_SINGLE_REQUEST_MAX_ATTEMPTS=3
# MP3 bitrate (kbps) of the prepared mono 16 kHz audio, and ffmpeg run cap (s).
XAI_AUDIO_BITRATE_KBPS=48
XAI_FFMPEG_TIMEOUT_SECONDS=1800
# Scratch dir for downloaded/prepared audio. Must be real disk, NOT tmpfs (tmpfs is
# charged to the worker's MemoryMax). Uncomment if /tmp is tmpfs on this host.
# XAI_WORK_DIR=/var/tmp

# --- Background upload (POST /jobs with upload_pending=true) ---
# The API verifies the caller's Supabase user JWT (Authorization: Bearer). Configure
# ONE or BOTH key types; with neither set the new mode answers 503 (fails closed).
# Legacy HS256 project secret (Dashboard -> Project Settings -> API -> JWT Secret):
SUPABASE_JWT_SECRET=
# Projects on asymmetric JWT signing keys (ES256/RS256): enable JWKS. The URL is derived
# from SUPABASE_URL unless SUPABASE_JWT_JWKS_URL is set. Both may be enabled while a
# project rotates keys; the token's alg picks the key.
# SUPABASE_JWT_USE_JWKS=true
# SUPABASE_JWT_JWKS_URL=https://<ref>.supabase.co/auth/v1/.well-known/jwks.json
# Defaults: audience "authenticated", issuer "<SUPABASE_URL>/auth/v1" (set ISSUER= empty to skip).
# SUPABASE_JWT_AUDIENCE=authenticated
# SUPABASE_JWT_ISSUER=
# Storage bucket holding recordings (same as the iOS app).
# RECORDINGS_BUCKET=recordings
# Largest expected_bytes accepted. The Supabase Storage global file-size limit and the
# bucket's limit must be at least this high (and >= ~150MB for 2 h meetings).
# MAX_UPLOAD_BYTES=314572800
# Worker gives up on an awaiting_upload job after this long (upload_expired).
# UPLOAD_PENDING_TTL_SECONDS=21600
# Allowed |stored size - expected_bytes| for promotion. Keep 0 unless you can justify more.
# UPLOAD_SIZE_TOLERANCE_BYTES=0

# --- Large single files (all providers; the worker's non-chunked, non-xAI-single path) ---
# Files above the threshold are cut with `ffmpeg -f segment` into ~5 min mono 16 kHz MP3
# pieces (2 s overlap), transcribed per piece and merged, instead of being decoded whole
# by pydub (which does not fit MemoryMax=1500M for 1-2 h audio). Applies to background-
# upload jobs only; jobs from the existing paths are unchanged. Needs ffmpeg + scratch
# disk (XAI_WORK_DIR, shared with the xAI path).
# LARGE_FILE_SEGMENTING_ENABLED=true
# LARGE_FILE_THRESHOLD_BYTES=15728640
# LARGE_FILE_THRESHOLD_SECONDS=1800
# LARGE_FILE_SEGMENT_SECONDS=300
# LARGE_FILE_OVERLAP_SECONDS=2
# LARGE_FILE_BITRATE_KBPS=48
# LARGE_FILE_FFMPEG_TIMEOUT_SECONDS=1800

# --- iOS Live Activity / Dynamic Island pushes via APNs (optional) ---
# Leave ALL of the four APNS_* unset to run exactly as before (no pushes, no extra
# network calls). See DEPLOYMENT.md "Live Activity (APNs) pushes" and
# docs/LIVE_ACTIVITY_CONTRACT.md. Needs the `h2` + `cryptography` packages (requirements.txt).
# Path to the AuthKey_XXXXXXXXXX.p8 (root:root 600, outside the git checkout), or the PEM
# text itself on one line with literal \n between lines.
# APNS_KEY_P8=/etc/snipnote-transcription/AuthKey_ABC123DEFG.p8
# APNS_KEY_ID=ABC123DEFG
# APNS_TEAM_ID=TEAM123456
# APNS_BUNDLE_ID=com.yourcompany.snipnote
# Master switch for pushes AND the transcription_jobs.stage write (default true).
# LIVE_ACTIVITY_ENABLED=true
# Minimum seconds between in-stage progress pushes (stage changes are never throttled).
# APNS_PROGRESS_INTERVAL_SECONDS=20
# Seconds until an update's stale-date (the app shows "still working" when stale).
# APNS_STALE_SECONDS=1200
# Seconds the ended activity stays on the lock screen (Apple caps it at 4 hours).
# APNS_DISMISSAL_SECONDS=10800
